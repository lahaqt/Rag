AUTHORING_POSTGRES_USER=authoring
AUTHORING_POSTGRES_PASSWORD=replace-me
AUTHORING_POSTGRES_PORT=25432
CONTENT_POSTGRES_USER=authoring
CONTENT_POSTGRES_PASSWORD=replace-me
AUTHORING_REDIS_PASSWORD=replace-me
CONTENT_REDIS_PASSWORD=replace-me
AUTHORING_RUSTFS_ACCESS_KEY=replace-me
AUTHORING_RUSTFS_SECRET_KEY=replace-me
CONTENT_RUSTFS_ACCESS_KEY=replace-me
CONTENT_RUSTFS_SECRET_KEY=replace-me
AUTHORING_ELASTIC_PASSWORD=replace-me
CONTENT_ELASTIC_PASSWORD=replace-me

AUTHORING_OIDC_ISSUER_URI=https://identity.example.com
AUTHORING_OIDC_JWK_SET_URI=https://identity.example.com/.well-known/jwks.json
AUTHORING_OIDC_AUDIENCE=authoring-service
AUTHORING_CONTENT_TOKEN_URI=https://identity.example.com/oauth2/token
AUTHORING_CONTENT_CLIENT_ID=authoring-service
AUTHORING_CONTENT_CLIENT_SECRET=replace-me
CONTENT_OIDC_ISSUER_URI=https://identity.example.com
CONTENT_OIDC_JWK_SET_URI=https://identity.example.com/.well-known/jwks.json
CONTENT_OIDC_AUDIENCE=content-service
CONTENT_OIDC_AUTHORIZED_CLIENT_ID=authoring-service

# Base64-encoded 32-byte AES key. Generate separately and never commit the value.
AUTHORING_CONFIG_ENCRYPTION_KEY=

# Retrieval planning uses the active immutable LLM snapshot. Cross-encoder is optional and fails back to RRF.
AUTHORING_RETRIEVAL_MULTI_QUERY_ENABLED=true
AUTHORING_RETRIEVAL_HYDE_ENABLED=true
AUTHORING_RETRIEVAL_MAX_QUERY_VARIANTS=3
AUTHORING_RETRIEVAL_HYDE_MAX_CHARACTERS=700
AUTHORING_RERANKER_ENABLED=false
AUTHORING_RERANKER_BASE_URL=
AUTHORING_RERANKER_PATH=/rerank
AUTHORING_RERANKER_MODEL=
AUTHORING_RERANKER_BEARER_TOKEN=
AUTHORING_RERANKER_TIMEOUT_SECONDS=5

VITE_OIDC_AUTHORITY=https://identity.example.com
VITE_OIDC_CLIENT_ID=engineering-authoring-coach-web
VITE_OIDC_AUDIENCE=authoring-service
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/app
